{
  "name": "multi-user-project-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Web-based, multi-user project planning system with multiple plans, baselines, branching and approvals.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @planning/server\" \"npm run dev -w @planning/client\"",
    "build": "npm run build -w @planning/shared && npm run build -w @planning/server && npm run build -w @planning/client && node scripts/docs-images.mjs --from-build",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:images": "node scripts/docs-images.mjs",
    "migrate": "npm run migrate -w @planning/server",
    "migrate:make": "npm run migrate:make -w @planning/server --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  }
}
